{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundsignal://medical/clinical-case.schema.json",
  "title": "GroundSignal Clinical Case",
  "type": "object",
  "required": ["case_id", "task_type", "patient_context", "evidence_snapshot", "interaction", "expected_behavior", "safety", "scoring"],
  "allOf": [
    {
      "anyOf": [
        {"required": ["graph_eval"]},
        {"required": ["decision_contract_exemption"]}
      ]
    }
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "task_type": {
      "type": "string",
      "enum": ["medical_qa", "clinical_reasoning", "medication_safety", "report_interpretation", "longitudinal", "multi_turn", "agent", "multimodal_ready"]
    },
    "data_origin": {
      "type": "string",
      "enum": ["synthetic", "public_deidentified", "licensed_deidentified"]
    },
    "patient_context": {
      "type": "object",
      "required": ["chief_complaint"],
      "properties": {
        "demographics": {"type": ["object", "null"]},
        "chief_complaint": {"type": "string"},
        "history": {"type": ["string", "null"]},
        "medications": {"type": "array", "items": {"type": "string"}},
        "allergies": {"type": "array", "items": {"type": "string"}},
        "examination": {"type": ["string", "null"]},
        "labs": {"type": "array", "items": {"type": "object"}},
        "imaging_reports": {"type": "array", "items": {"type": "object"}},
        "other_reports": {"type": "array", "items": {"type": "object"}},
        "longitudinal_events": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "evidence_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "allowed_passage_ids"],
      "properties": {
        "snapshot_id": {"type": "string"},
        "as_of_date": {"type": ["string", "null"], "format": "date"},
        "allowed_passage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "withheld_passage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["mode", "prompt"],
      "properties": {
        "mode": {"type": "string", "enum": ["single_turn", "multi_turn"]},
        "prompt": {"type": "string"},
        "prior_turns": {"type": "array", "items": {"type": "object"}},
        "tool_policy": {"type": ["object", "null"]},
        "modality_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "expected_behavior": {
      "type": "object",
      "required": ["must_include", "must_not_claim", "uncertainty_behavior"],
      "properties": {
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_not_claim": {"type": "array", "items": {"type": "string"}},
        "acceptable_actions": {"type": "array", "items": {"type": "string"}},
        "uncertainty_behavior": {"type": "string"},
        "clarification_or_escalation": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "graph_eval": {
      "type": "object",
      "required": ["required_node_ids", "required_edge_ids", "expected_reasoning_path"],
      "properties": {
        "graph_snapshot_id": {"type": "string"},
        "required_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_edge_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_claims": {"type": "array", "items": {"type": "string"}},
        "expected_reasoning_path": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "decision_contract_exemption": {
      "type": "object",
      "required": ["type", "rationale"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["NO_GRAPH_DECISION_REQUIRED", "NON_REASONING_CONTROL", "EXTERNAL_TRAJECTORY_ONLY"]
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "benchmark_provenance": {
      "type": "object",
      "required": ["stage", "suite_id", "family_id", "split", "variant_type", "evidence_class", "fresh_evidence", "source_case_path", "source_manifest_path", "source_manifest_sha256", "source_case_sha256", "materializer_version", "provenance_mode", "training_eligible"],
      "properties": {
        "stage": {"const": "S5"},
        "suite_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "split": {"type": "string", "enum": ["dev", "regression", "heldout"]},
        "variant_type": {"type": "string", "minLength": 1},
        "evidence_class": {"type": ["string", "null"]},
        "fresh_evidence": {"type": "boolean"},
        "source_snapshot_commit": {"type": ["string", "null"]},
        "source_manifest_path": {"type": "string", "minLength": 1},
        "source_case_path": {"type": "string", "minLength": 1},
        "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materialized_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "materializer_version": {"type": "string", "minLength": 1},
        "provenance_mode": {"type": "string", "enum": ["materialized_manifest_bound", "source_manifest_resolved"]},
        "training_eligible": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"provenance_mode": {"const": "materialized_manifest_bound"}}, "required": ["provenance_mode"]},
          "then": {"required": ["materialized_payload_sha256"]}
        }
      ],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["critical_errors"],
      "properties": {
        "critical_errors": {"type": "array", "items": {"type": "string"}},
        "hard_gate_dimensions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["rubric_version"],
      "properties": {
        "rubric_version": {"type": "string"},
        "judge_version": {"type": ["string", "null"]},
        "dimensions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
