    },
    {
      "item_id": "S3A52-011",
      "role": "evidence",
      "text": "Spontaneous case reports can flag a safety signal for investigation, but the reports alone do not demonstrate that the product caused the event.",
      "expected_propositions": [
        {"subject":"spontaneous_report_system","predicate":"SUPPORTS_SIGNAL_DETECTION","object":"safety_signal","polarity":"POSITIVE","conditions":[],"population":null,"critical":false},
        {"subject":"evidence","predicate":"ESTABLISHES_CAUSALITY","object":"causal_relation","polarity":"NEGATIVE","conditions":[],"population":null,"critical":true}
      ],
      "expected_abstain": false,
      "tags": ["signal","causality","contrastive_scope"]
    },
    {
      "item_id": "S3A52-012",
      "role": "evidence",
      "text": "Temporal proximity may justify follow-up; it must not be treated as proof of causation on its own.",
      "expected_propositions": [{"subject":"evidence","predicate":"ESTABLISHES_CAUSALITY","object":"causal_relation","polarity":"NEGATIVE","conditions":[],"population":null,"critical":true}],
      "expected_abstain": false,
      "tags": ["modality","causality","negation"]
    },
    {
