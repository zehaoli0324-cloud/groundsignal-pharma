    {
      "item_id": "S3A52-009",
      "role": "evidence",
      "text": "The document states a contraindication at eGFR below 24, yet explicitly says that advanced age by itself is not a contraindication.",
      "expected_propositions": [
        {"subject":"drug_use","predicate":"CONTRAINDICATED","object":"use","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":24}],"population":null,"critical":true},
