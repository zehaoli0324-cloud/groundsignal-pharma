    "trace_contract_required": true
  },
  "items": [
    {
      "item_id": "S3A52-001",
      "role": "evidence",
      "text": "In patients not yet treated, starting therapy is not recommended when eGFR is below 43; a sodium value of 132 mmol/L in the same paragraph is unrelated.",
      "expected_propositions": [{"subject":"drug_initiation","predicate":"INITIATION_NOT_RECOMMENDED","object":"initiation","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":43}],"population":"new_or_initiating_user","critical":true}],
      "expected_abstain": false,
      "tags": ["population","threshold","numeric_distractor"]
    },
    {
      "item_id": "S3A52-002",
      "role": "candidate",
      "text": "A treatment-naive patient with eGFR 41 is in the group for whom initiation is not recommended.",
      "expected_propositions": [{"subject":"drug_initiation","predicate":"INITIATION_NOT_RECOMMENDED","object":"initiation","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"EQ","value":41}],"population":"new_or_initiating_user","critical":true}],
      "expected_abstain": false,
      "tags": ["population","point_condition","candidate"]
    },
    {
      "item_id": "S3A52-003",
      "role": "evidence",
      "text": "For people already receiving the medicine, reassess benefit versus risk once eGFR falls under 47, not when the unrelated heart rate falls under 50 beats per minute.",
      "expected_propositions": [{"subject":"drug_use","predicate":"REASSESS_BENEFIT_RISK","object":"benefit_risk","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":47}],"population":"existing_user","critical":true}],
      "expected_abstain": false,
      "tags": ["population","numeric_distractor","condition_scope"]
    },
    {
      "item_id": "S3A52-004",
      "role": "evidence",
      "text": "Those already on treatment should stop it below eGFR 27. They should not stop it merely because age exceeds 82 years.",
      "expected_propositions": [
        {"subject":"drug_use","predicate":"DISCONTINUE","object":"drug","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":27}],"population":"existing_user","critical":true},
        {"subject":"drug_use","predicate":"DISCONTINUE","object":"drug","polarity":"NEGATIVE","conditions":[],"population":"existing_user","critical":true}
      ],
      "expected_abstain": false,
      "tags": ["cross_sentence_population","mixed_polarity","numeric_distractor"]
    },
    {
      "item_id": "S3A52-005",
      "role": "evidence",
      "text": "For a new starter, eGFR from 36 through 44 is a range in which initiation is not recommended; for someone continuing therapy, the same renal value instead calls for benefit-risk review.",
      "expected_propositions": [
        {"subject":"drug_initiation","predicate":"INITIATION_NOT_RECOMMENDED","object":"initiation","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"RANGE","low":36,"high":44}],"population":"new_or_initiating_user","critical":true},
        {"subject":"drug_use","predicate":"REASSESS_BENEFIT_RISK","object":"benefit_risk","polarity":"POSITIVE","conditions":[],"population":"existing_user","critical":true}
      ],
      "expected_abstain": false,
      "tags": ["competing_population","anaphora","range"]
    },
    {
      "item_id": "S3A52-006",
      "role": "evidence",
      "text": "Existing users require reassessment below eGFR 46 and discontinuation only below 29; hemoglobin 10.1 g/dL does not define either renal action.",
      "expected_propositions": [
        {"subject":"drug_use","predicate":"REASSESS_BENEFIT_RISK","object":"benefit_risk","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":46}],"population":"existing_user","critical":true},
        {"subject":"drug_use","predicate":"DISCONTINUE","object":"drug","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":29}],"population":"existing_user","critical":true}
      ],
      "expected_abstain": false,
      "tags": ["competing_thresholds","shared_population","numeric_distractor"]
    },
    {
      "item_id": "S3A52-007",
      "role": "candidate",
      "text": "An established user at eGFR 32 should not discontinue the drug on the basis of that value alone.",
      "expected_propositions": [{"subject":"drug_use","predicate":"DISCONTINUE","object":"drug","polarity":"NEGATIVE","conditions":[{"variable":"egfr","operator":"EQ","value":32}],"population":"existing_user","critical":true}],
      "expected_abstain": false,
      "tags": ["negative_action","point_condition","population"]
    },
    {
      "item_id": "S3A52-008",
      "role": "evidence",
      "text": "Treatment is not, despite the warning elsewhere in the label, contraindicated solely because condition M is present.",
