{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-extractor-output.schema.json",
  "title": "S3a Semantic Extractor Output",
  "type": "object",
  "required": ["propositions", "abstain", "unresolved_spans"],
  "properties": {
    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "predicate", "object", "polarity", "conditions", "confidence"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "object": {"type": ["string", "number", "null"]},
          "polarity": {"enum": ["POSITIVE", "NEGATIVE"]},
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variable", "operator"],
              "properties": {
                "variable": {"type": "string"},
                "operator": {"enum": ["EQ", "LT", "RANGE"]},
                "value": {"type": ["number", "null"]},
                "low": {"type": ["number", "null"]},
                "high": {"type": ["number", "null"]}
              },
              "additionalProperties": false
            }
          },
          "population": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_span": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "abstain": {"type": "boolean"},
    "unresolved_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "reason", "potentially_critical"],
        "properties": {
          "text": {"type": "string"},
          "reason": {"type": "string"},
          "potentially_critical": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
