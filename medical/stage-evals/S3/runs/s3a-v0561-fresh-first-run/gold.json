  "items": [
    {
      "item_id": "S3A561F-001",
      "role": "evidence",
      "text": "At eGFR below 41, people already taking the medicine should discontinue it, whereas patients being newly started should not initiate treatment.",
      "expected_propositions": [
        {"subject":"drug_use","predicate":"DISCONTINUE","object":"drug","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":41}],"population":"existing_user","critical":true},
        {"subject":"drug_initiation","predicate":"INITIATION_NOT_RECOMMENDED","object":"initiation","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":41}],"population":"new_or_initiating_user","critical":true}
      ],
      "expected_abstain": false,
      "tags": ["frame_event_registry","shared_preposed_condition","finite_initiate"]
    },
    {
      "item_id": "S3A561F-002",
      "role": "evidence",
      "text": "When eGFR is under 45, initiation is not recommended for a new patient, while an existing user should have a benefit-risk review.",
