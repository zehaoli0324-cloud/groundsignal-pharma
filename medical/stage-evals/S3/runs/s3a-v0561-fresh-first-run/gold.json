        {"subject":"drug_initiation","predicate":"INITIATION_NOT_RECOMMENDED","object":"initiation","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":45}],"population":"new_or_initiating_user","critical":true},
        {"subject":"drug_use","predicate":"REASSESS_BENEFIT_RISK","object":"benefit_risk","polarity":"POSITIVE","conditions":[{"variable":"egfr","operator":"LT","value":45}],"population":"existing_user","critical":true}
      ],
      "expected_abstain": false,
      "tags": ["shared_preposed_condition","competing_population"]
    },
    {
