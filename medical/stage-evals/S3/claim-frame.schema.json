{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundsignal.local/schemas/s3-claim-frame-v0.3.json",
  "title": "S3 Directional ClaimFrame",
  "type": "object",
  "required": ["entities", "relations", "conditions", "modalities", "causal_status", "temporal_status", "limitations"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "predicate", "object", "polarity"],
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "polarity": {"enum": ["POSITIVE", "NEGATIVE", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "operator"],
        "properties": {
          "variable": {"type": "string"},
          "operator": {"enum": ["LT", "LE", "GT", "GE", "EQ", "RANGE", "UNKNOWN"]},
          "value": {"type": ["number", "string", "null"]},
          "low": {"type": ["number", "null"]},
          "high": {"type": ["number", "null"]},
          "applies_to": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "modalities": {
      "type": "array",
      "items": {
        "enum": [
          "REQUIRED",
          "RECOMMENDED",
          "NOT_RECOMMENDED",
          "CONTRAINDICATED",
          "REASSESS",
          "DISCONTINUE",
          "RISK_INCREASE",
          "POSSIBLE",
          "ASSOCIATED",
          "SIGNAL_ONLY",
          "DIAGNOSIS_CONFIRMED",
          "EFFICACY_PROVEN",
          "MANAGEMENT_REQUIRED",
          "MANAGEMENT_UNRESOLVED"
        ]
      },
      "uniqueItems": true
    },
    "causal_status": {
      "enum": ["CAUSAL", "ASSOCIATION", "SIGNAL_ONLY", "NOT_ESTABLISHED", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "temporal_status": {
      "enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "PENDING_UPDATE", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "raw_cues": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
