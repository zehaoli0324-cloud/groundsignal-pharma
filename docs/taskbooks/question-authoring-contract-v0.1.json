  "invariant_rules": [
    "No author labels in applicability generation",
    "No future facts in earlier windows",
    "Separate observed failure from causal hypothesis",
    "Separate evaluator faults from target-system faults",
    "Do not count variants or repeat runs as independent clinical cases",
    "Clinical applicability reviewed before independent A/B scoring"
  ],
